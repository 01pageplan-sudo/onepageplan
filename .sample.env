# ==============================================================================
# ONE PAGE PLAN (onepageplan.in) — VERCEL ENVIRONMENT VARIABLES (.sample.env)
# ==============================================================================
# Copy the values below into your Vercel Project Settings:
# Vercel Dashboard -> Project -> Settings -> Environment Variables.
#
# IMPORTANT VERCEL SECURITY RULE:
# - Variables starting with VITE_ are public and bundled into client browser code.
# - Variables WITHOUT VITE_ are private secrets only accessible by serverless functions.
# ==============================================================================

# ==============================================================================
# 1. CORE APPLICATION & ADMIN AUTHENTICATION
# ==============================================================================
# Public production site domain
VITE_SITE_URL=https://onepageplan.in

# Master Admin Password used to unlock /admin and authenticate Supabase RPC functions
# In Vercel: Set as sensitive/encrypted server variable
ADMIN_PASSWORD=your_secure_admin_password_here

# Shared secret for scheduled cron dispatches (/api/public/email-dispatch)
# In Vercel: Add this secret; pg_cron or Vercel Cron sends this in x-cron-secret header
WEBHOOK_SHARED_SECRET=your_random_secure_shared_secret_here
CRON_SHARED_SECRET=your_random_secure_shared_secret_here

# ==============================================================================
# 2. SUPABASE DATABASE (https://supabase.com)
# ==============================================================================
# In Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://gdnekidfshegfgvshtsi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here

# Server-side references (must match the above)
SUPABASE_URL=https://gdnekidfshegfgvshtsi.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here

# ==============================================================================
# 3. ZOHO ZEPTOMAIL (Transactional & Nurture Email Automation)
# ==============================================================================
# Generate your Send Mail Token in Zoho ZeptoMail Dashboard -> Mail Agents -> SMTP / API
# Format starts with Zoho-enczapikey or raw token
ZEPTOMAIL_API_KEY=Zoho-enczapikey_your_zeptomail_send_token_here

# ZeptoMail REST API Endpoint:
# - For India Data Center (.in): https://api.zeptomail.in/v1.1/email
# - For US / Global Data Center (.com): https://api.zeptomail.com/v1.1/email
# - For EU Data Center (.eu): https://api.zeptomail.zoho.eu/v1.1/email
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email

# Signing secret from Zoho ZeptoMail -> Webhooks -> Add Webhook
# Endpoint: https://onepageplan.in/api/public/zeptomail-webhook
# Events: delivered, open, click, bounce
ZEPTOMAIL_WEBHOOK_SECRET=your_zeptomail_webhook_signing_secret_here

# Verified Sender Name & Email (must match the domain verified in Zoho ZeptoMail)
FROM_NAME=Milan Dodhia
FROM_EMAIL=connect@onepageplan.in

# (Optional fallback) Resend API Key if you ever need dual fallback
RESEND_API_KEY=

# ==============================================================================
# 4. DIRECT META WHATSAPP CLOUD API (v21.0 — Direct Meta Integration)
# ==============================================================================
# Set to 'true' to enable live WhatsApp dispatches to attendees' handsets
WHATSAPP_ENABLED=true

# 15-digit Phone Number ID (From Meta Developers -> Your App -> WhatsApp -> API Setup)
# NOTE: This is the Phone Number ID, NOT your personal mobile or WABA ID.
WHATSAPP_PHONE_NUMBER_ID=your_15_digit_meta_phone_number_id_here

# Permanent System User Access Token (Meta Business Manager -> System Users)
# Permissions needed: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=EAAG...your_permanent_system_user_token...

# Custom verification secret for Meta Webhook handshake
# Set this exact same string in Meta Dashboard -> WhatsApp -> Configuration -> Webhook
# Endpoint: https://onepageplan.in/api/public/whatsapp-webhook
WHATSAPP_VERIFY_TOKEN=onepageplan_whatsapp_verify_token_here

# Meta App Secret (From Meta App Dashboard -> App Settings -> Basic -> App Secret)
# Used to verify incoming X-Hub-Signature-256 HMAC signatures
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Template language ('en' for generic English, 'en_US' for US English)
WHATSAPP_TEMPLATE_LANG=en

# Approved Meta WhatsApp Template Names (as named in WhatsApp Template Manager)
WHATSAPP_TEMPLATE_CONFIRMATION=webinar_confirmation
WHATSAPP_TEMPLATE_REMINDER_2H=webinar_reminder_2h
WHATSAPP_TEMPLATE_REMINDER_15M=webinar_reminder_15m
WHATSAPP_TEMPLATE_LIVE=webinar_live_now
WHATSAPP_TEMPLATE_FOLLOWUP=webinar_followup
WHATSAPP_TEMPLATE_PURCHASE=course_purchase_confirmation

# ==============================================================================
# 5. DIRECT RAZORPAY PAYMENT GATEWAY (Bypassing Tagmango)
# ==============================================================================
# In Razorpay Dashboard: Settings -> API Keys (Generate Test or Live Key)
# Key ID is public and passed to the client browser checkout modal
VITE_RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id_here
RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id_here

# Key Secret is strictly private (server only, never exposed to browser)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook Secret from Razorpay Dashboard -> Settings -> Webhooks
# Endpoint: https://onepageplan.in/api/public/razorpay-webhook
# Events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ==============================================================================
# 6. WEBINAR.GG INTEGRATION (In-Page Live Room /room)
# ==============================================================================
# Webinar.gg API Token (from Webinar.gg profile/developer settings)
WEBINAR_GG_API_TOKEN=your_webinar_gg_api_token_here
WEBINAR_GG_API_KEY=your_webinar_gg_api_token_here

# Recurring Masterclass Webinar ID on Webinar.gg
WEBINAR_GG_WEBINAR_ID=cmthk6y4001kos60ybxfkbc67

# Public URL to join session (defaults to internal /room)
VITE_WEBINAR_URL=https://onepageplan.in/room

# Set to 'false' in production so attendees must be registered to enter
VITE_ROOM_TEST_MODE=false

# ==============================================================================
# 7. TRACKING PIXELS & MEDIA ASSETS (Client-side)
# ==============================================================================
# Meta (Facebook) Pixel ID
VITE_META_PIXEL_ID=1670593947760231

# WhatsApp Community / Group Invite Link shown on /confirmed page
VITE_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/your_invite_link_here

# Video embed URLs (YouTube / Vimeo embed URLs)
# VSL on homepage hero block
VITE_VSL_URL=
# Video on /confirmed thank-you page
VITE_PREP_VIDEO_URL=
