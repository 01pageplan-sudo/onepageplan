# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES (Vercel / Netlify Bulk Import Format)
# =============================================================================
# In Vercel: Project Settings -> Environment Variables -> Paste this block.
# Ensure all placeholders (<...>) are replaced before saving.
# =============================================================================

# Public Site & Admin Settings
VITE_SITE_URL=https://<your-coach-domain.com>
VITE_ADMIN_SUBDOMAIN=admin.<your-coach-domain.com>
SUBDOMAIN_ADMIN_ENABLED=true
ADMIN_PASSWORD=<strong_random_admin_password>

# Database (Supabase)
VITE_SUPABASE_URL=https://<supabase-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-anon-key>
VITE_SUPABASE_PROJECT_ID=<supabase-ref>
SUPABASE_URL=https://<supabase-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-anon-key>

# Email Delivery (Resend)
RESEND_API_KEY=<re_your_resend_api_key>
FROM_EMAIL=connect@<your-coach-domain.com>
FROM_NAME=<Coach Full Name>
RESEND_WEBHOOK_SECRET=<whsec_resend_signing_secret>
CRON_SHARED_SECRET=<random_32char_cron_secret>

# WhatsApp Automation (Direct Meta Cloud API)
WHATSAPP_ENABLED=true
WHATSAPP_API_VERSION=v19.0
WHATSAPP_ACCESS_TOKEN=<EAAG_meta_system_user_token>
WHATSAPP_PHONE_NUMBER_ID=<meta_phone_number_id>
WHATSAPP_VERIFY_TOKEN=<custom_meta_webhook_verify_token>
WHATSAPP_APP_SECRET=<meta_app_secret>
WHATSAPP_TEMPLATE_CONFIRMATION=masterclass_registration_confirmed
WHATSAPP_TEMPLATE_REMINDER_24H=masterclass_reminder_24h
WHATSAPP_TEMPLATE_REMINDER_1H=masterclass_reminder_1h
WHATSAPP_TEMPLATE_LIVE_NOW=masterclass_live_now

# Webinar Platform (Webinar.gg)
WEBINAR_GG_API_TOKEN=<webinar_gg_api_token>
WEBINAR_GG_WEBINAR_ID=<webinar_gg_webinar_id>
VITE_WEBINAR_URL=https://webinar.gg/register/<webinar_gg_webinar_id>
VITE_ROOM_TEST_MODE=false
WEBHOOK_SHARED_SECRET=<random_webinar_webhook_secret>

# Payment Gateways (Razorpay & Stripe)
PAYMENT_GATEWAY=razorpay
VITE_RAZORPAY_KEY_ID=<rzp_live_key_id>
RAZORPAY_KEY_SECRET=<razorpay_key_secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay_webhook_secret>
VITE_STRIPE_PUBLISHABLE_KEY=<pk_live_stripe_publishable_key>
STRIPE_SECRET_KEY=<sk_live_stripe_secret_key>
STRIPE_WEBHOOK_SECRET=<whsec_stripe_webhook_secret>

# Tracking & Analytics
VITE_META_PIXEL_ID=<meta_pixel_id>
VITE_GOOGLE_ANALYTICS_ID=<ga4_measurement_id>
VITE_WHATSAPP_GROUP_URL=<https_chat_whatsapp_com_invite>
