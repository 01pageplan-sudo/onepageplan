# =============================================================================
# Direct Meta WhatsApp Cloud API Configuration
# =============================================================================
# Obtain these credentials from the Meta App Dashboard (https://developers.facebook.com/apps)
# under: Your App -> WhatsApp -> API Setup & Configuration.

# 1. Meta Permanent System User Access Token
# Must have permissions: `whatsapp_business_messaging`, `whatsapp_business_management`
# Generated via Meta Business Manager -> System Users -> Generate Token.
WHATSAPP_ACCESS_TOKEN="EAAG..."

# 2. WhatsApp Business Phone Number ID
# Found under WhatsApp -> API Setup -> "Phone number ID" (e.g. 104829104812345)
# NOTE: This is NOT the WABA (WhatsApp Business Account) ID or the raw phone number.
WHATSAPP_PHONE_NUMBER_ID="104829104812345"

# 3. WhatsApp Business Account ID (WABA ID)
# Found under Meta Business Manager -> Accounts -> WhatsApp Accounts -> (Your WABA) -> ID
WHATSAPP_WABA_ID="102938475610293"

# 4. Custom Webhook Verification Token
# Any secure random string defined by you. Must match the "Verify Token" field
# entered in the Meta App Dashboard under WhatsApp -> Configuration -> Webhook.
WHATSAPP_VERIFY_TOKEN="your_custom_secure_verify_token_here"

# 4. WhatsApp Cloud API Version (Optional, defaults to v19.0)
WHATSAPP_API_VERSION="v19.0"

# 5. Meta App Secret (Optional, for enterprise X-Hub-Signature-256 HMAC verification)
# Found under Meta App Dashboard -> App settings -> Basic -> App secret.
# Leave blank to bypass signature verification during local development.
WHATSAPP_APP_SECRET=""
