# =============================================================================
# LEAD ACQUISITION & NURTURING AUTOMATION — UNIVERSAL ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to `.env` for local development.
# For Vercel/Netlify/Cloudflare, add these variables in your hosting settings.
# Variables prefixed with `VITE_` are exposed to the browser client.
# Variables without `VITE_` are secret server-only variables.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & DOMAINS
# -----------------------------------------------------------------------------
# Main website URL (where the acquisition landing page is hosted)
VITE_SITE_URL=https://yourcoachdomain.com

# Admin Portal Subdomain (or keep empty if using yourcoachdomain.com/admin)
VITE_ADMIN_SUBDOMAIN=admin.yourcoachdomain.com
SUBDOMAIN_ADMIN_ENABLED=true

# Master Admin Password for /admin console and server RPC authentication
ADMIN_PASSWORD=change_this_to_a_strong_random_password_123!

# -----------------------------------------------------------------------------
# 2. SUPABASE DATABASE & AUTH (https://supabase.com)
# -----------------------------------------------------------------------------
# In Supabase: Project Settings -> API
# Note: In Supabase's new API key system, "Publishable key" (sb_publishable_...) is the
# modern replacement for the traditional "anon key". Both are supported interchangeably.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-side access (matches publishable / anon key for client-scoped operations)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# Optional: Service role key for elevated backend worker tasks
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# 3. EMAIL AUTOMATION (ZOHO ZEPTOMAIL — Primary / Resend fallback)
# -----------------------------------------------------------------------------
# Zoho ZeptoMail Send Mail API Key (From Zoho ZeptoMail -> Mail Agents -> Setup API)
ZEPTOMAIL_API_KEY=Zoho-enczapikey_your_send_mail_token_here
# Endpoint: https://api.zeptomail.in/v1.1/email (India) or https://api.zeptomail.com/v1.1/email (Global)
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_WEBHOOK_SECRET=your_zeptomail_webhook_secret

# Sender Name and Verified Sending Domain Email Address
FROM_NAME="Milan Dodhia"
FROM_EMAIL="connect@onepageplan.in"

# (Optional fallback) Resend API Key
RESEND_API_KEY=

# Shared secret for scheduled cron trigger (Header: x-cron-secret)
CRON_SHARED_SECRET=your_secure_random_cron_shared_secret

# -----------------------------------------------------------------------------
# 4. DIRECT META WHATSAPP CLOUD API (Meta Developer Platform)
# -----------------------------------------------------------------------------
# Enable live WhatsApp messaging (Set to false during development or before approval)
WHATSAPP_ENABLED=false

# Meta Graph API Version (defaults to v19.0)
WHATSAPP_API_VERSION=v19.0

# Permanent System User Access Token generated via Meta Business Manager -> System Users
# Required permissions: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=EAAG...your_meta_system_user_token...

# WhatsApp Business Phone Number ID (From Meta App Dashboard -> WhatsApp -> API Setup)
# NOTE: This is the 15-digit Phone Number ID, NOT your personal phone or WABA ID.
WHATSAPP_PHONE_NUMBER_ID=104829104812345

# WhatsApp Business Account ID (WABA ID)
WHATSAPP_WABA_ID=102938475610293

# Webhook Verification Token (Any custom secret string matching Meta Webhook config)
WHATSAPP_VERIFY_TOKEN=your_custom_secure_verify_token_here

# Meta App Secret (From App Dashboard -> App Settings -> Basic -> App Secret)
# Used to verify incoming X-Hub-Signature-256 HMAC headers
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# WhatsApp Approved Template Names (Meta App Dashboard -> Message Templates)
WHATSAPP_TEMPLATE_CONFIRMATION=masterclass_registration_confirmed
WHATSAPP_TEMPLATE_REMINDER_24H=masterclass_reminder_24h
WHATSAPP_TEMPLATE_REMINDER_1H=masterclass_reminder_1h
WHATSAPP_TEMPLATE_LIVE_NOW=masterclass_live_now

# -----------------------------------------------------------------------------
# 5. WEBINAR PLATFORM INTEGRATION (Webinar.gg / Embedded Room)
# -----------------------------------------------------------------------------
# Webinar.gg API Token (from webinar.gg account settings)
WEBINAR_GG_API_TOKEN=your_webinar_gg_api_token_here

# Default Webinar ID (from webinar.gg event URL)
WEBINAR_GG_WEBINAR_ID=your_webinar_id_here
VITE_WEBINAR_URL=https://webinar.gg/register/your_webinar_id_here

# Set to "true" to test the live room (/room) without requiring actual registration
VITE_ROOM_TEST_MODE=false

# Shared secret for webinar platform webhooks (Header: x-webhook-secret)
WEBHOOK_SHARED_SECRET=your_random_webinar_webhook_secret

# -----------------------------------------------------------------------------
# 6. LEVEL 1 PAYMENT GATEWAY INTEGRATION (Razorpay & Stripe)
# -----------------------------------------------------------------------------
# Active Payment Gateway: "razorpay" (India/UPI/Cards) or "stripe" (International)
PAYMENT_GATEWAY=razorpay

# Razorpay Keys (https://dashboard.razorpay.com -> Settings -> API Keys)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Stripe Keys (https://dashboard.stripe.com/apikeys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# -----------------------------------------------------------------------------
# 7. ANALYTICS & PIXEL TRACKING (Browser-side)
# -----------------------------------------------------------------------------
# Meta (Facebook) Pixel ID (Leave empty to disable)
VITE_META_PIXEL_ID=

# Google Tag Manager / Analytics Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GOOGLE_ANALYTICS_ID=

# Hotjar Site ID (Optional)
VITE_HOTJAR_ID=

# ChatGPT / OpenAI Ads Conversion API (Server-side secret) & Pixel ID
CHATGPT_CONVERSION_API_KEY=
CHATGPT_PIXEL_ID=LCLQYPUtFAeHU1BCs5buMR

# -----------------------------------------------------------------------------
# 8. OPTIONAL OVERRIDES & COMMUNITY
# -----------------------------------------------------------------------------
# WhatsApp Community / Group Invite Link shown on confirmation page
VITE_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/your-group-invite-link

# Video Sales Letter (VSL) / Preparation Video URL (YouTube/Vimeo/MP4)
VITE_VSL_URL=
VITE_PREP_VIDEO_URL=
